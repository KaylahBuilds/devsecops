# =============================================================================
# secrets.auto.tfvars.example - Slack / Teams webhook URLs (SECRET, never commit)
# =============================================================================
# An incoming-webhook URL is a credential: whoever holds it can post into the
# channel. So webhook URLs never go into terraform.tfvars or examples/*.tfvars
# (both are committed). notifications.tf reads them from the sensitive
# variable `notification_webhooks` (variables.tf), keyed by GitHub org, and
# attaches them to that org's `notifications` entry. An org with no entry here
# simply gets no webhook delivery; an entry for an org that has no
# `notifications` entry is ignored.
#
# How to use this file
#   Locally   cd stepsecurity
#             cp examples/secrets.auto.tfvars.example secrets.auto.tfvars
#             Edit the URLs, then run terraform plan / apply as usual. Terraform
#             auto-loads every *.auto.tfvars in the working directory, and the
#             repo .gitignore ignores *.auto.tfvars, so the file never reaches git.
#   In CI     Do not create the file. Pass the same map through an environment
#             variable fed from a repository secret (Terraform reads TF_VAR_<name>
#             and parses it as HCL, which accepts JSON syntax for a map):
#               TF_VAR_notification_webhooks='{"acme-corp":{"teams_webhook_url":"https://..."},"acme-labs":{"slack_webhook_url":"https://..."}}'
#
# The URLs below are placeholders in the shape of real ones - they do not work.
# Pairs with examples/07-notifications-and-suppressions.tfvars (same two orgs).
# =============================================================================

# Map keyed by GitHub org. Both attributes are optional; leave out the one an
# org does not use. variables.tf marks the variable sensitive, so plan / apply
# output prints "(sensitive value)" instead of the URLs.
notification_webhooks = { # org name -> webhook URLs (default: {} = no webhook delivery anywhere)
  # acme-corp: alerts go to a Microsoft Teams channel. Slack for this org goes
  # through the StepSecurity Slack app (slack_channel_id in the 07 example), so
  # no Slack webhook is needed. The key must match the `notifications` key exactly.
  "acme-corp" = {
    teams_webhook_url = "https://example.webhook.office.com/webhookb2/<workflow-id>@<tenant-id>/IncomingWebhook/<key>/<group-id>" # Teams incoming webhook: channel -> Manage channel -> Connectors (or Workflows) -> Incoming Webhook (default: null = no Teams delivery)
    # slack_webhook_url = "https://hooks.slack.com/services/T0000000000/B0000000000/replace-with-your-webhook-token" # optional: Slack incoming webhook; not needed when the org sets slack_channel_id (OAuth app) (default: null)
  }

  # acme-labs: Slack through a plain incoming webhook. The 07 example sets no
  # slack_channel_id for this org, so notifications.tf leaves
  # slack_notification_method at the provider default ("webhook"). Key = `notifications` key.
  "acme-labs" = {
    slack_webhook_url = "https://hooks.slack.com/services/T0000000000/B0000000000/replace-with-your-webhook-token" # Slack incoming webhook: api.slack.com/apps -> your app -> Incoming Webhooks -> Add New Webhook to Workspace (default: null = no Slack delivery)
    # teams_webhook_url = "https://example.webhook.office.com/webhookb2/<workflow-id>@<tenant-id>/IncomingWebhook/<key>/<group-id>" # optional: Teams incoming webhook for this org too (default: null)
  }
}
